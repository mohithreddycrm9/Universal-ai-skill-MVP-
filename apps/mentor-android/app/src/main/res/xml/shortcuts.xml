<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="morning_brief"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_morning_brief"
        android:shortcutLongLabel="@string/shortcut_morning_brief_long">
        <intent
            android:action="com.skillmcp.mentor.USE_CASE"
            android:targetPackage="com.skillmcp.mentor"
            android:targetClass="com.skillmcp.mentor.TrustedLaunchActivity">
            <extra
                android:name="use_case_id"
                android:value="daily-brief" />
            <extra
                android:name="internal_launch"
                android:value="true" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="polish_message"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
