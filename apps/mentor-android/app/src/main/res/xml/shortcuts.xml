        <intent
            android:action="com.skillmcp.mentor.USE_CASE"
            android:targetPackage="com.skillmcp.mentor"
            android:targetClass="com.skillmcp.mentor.TrustedLaunchActivity">
            <extra
                android:name="use_case_id"
                android:value="rewrite-message" />
            <extra
                android:name="internal_launch"
                android:value="true" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="meal_plan"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_meal"
        android:shortcutLongLabel="@string/shortcut_meal_long">
        <intent
            android:action="com.skillmcp.mentor.USE_CASE"
            android:targetPackage="com.skillmcp.mentor"
            android:targetClass="com.skillmcp.mentor.TrustedLaunchActivity">
            <extra
                android:name="use_case_id"
