                android:name="internal_launch"
                android:value="true" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="new_chat"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_chat"
        android:shortcutLongLabel="@string/shortcut_chat_long">
        <intent
            android:action="com.skillmcp.mentor.OPEN_TAB"
            android:targetPackage="com.skillmcp.mentor"
            android:targetClass="com.skillmcp.mentor.TrustedLaunchActivity">
            <extra
                android:name="tab_route"
                android:value="chat" />
            <extra
                android:name="internal_launch"
                android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
