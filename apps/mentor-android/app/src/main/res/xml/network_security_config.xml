<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is required for user-configured Ollama http://LAN URLs. Cloud LLM calls use HTTPS OkHttp clients. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
