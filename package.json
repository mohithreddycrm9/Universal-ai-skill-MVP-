{
  "name": "@skill-mcp/universal-skill-trust",
  "version": "0.1.0",
  "description": "Universal Skills MCP — free/OSS-first skill discovery, verification, and delivery",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "skill-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --experimental-sqlite dist/index.js",
    "dev": "tsx --experimental-sqlite src/index.ts",
    "cli": "tsx --experimental-sqlite src/index.ts",
    "test": "node --experimental-sqlite ./node_modules/vitest/vitest.mjs run",
    "test:e2e": "node --experimental-sqlite ./node_modules/vitest/vitest.mjs run tests/e2e",
    "test:watch": "node --experimental-sqlite ./node_modules/vitest/vitest.mjs",
    "bench": "tsx --experimental-sqlite tests/perf/benchmark.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run typecheck && npm run build && npm test",
    "validate:claude-plugin": "npx -y @anthropic-ai/claude-code@2.1.280 plugin validate .",
    "validate:docker": "npm run validate && node --experimental-sqlite ./node_modules/vitest/vitest.mjs run tests/e2e/mvp-lifecycle.test.ts -t 'L — Docker'",
    "demo:build-suggestions": "npm run build && node --experimental-sqlite scripts/demo-build-suggestions.mjs",
    "suggest": "npm run build && node --experimental-sqlite dist/index.js suggest --demo"
  },
  "keywords": [
    "mcp",
    "skills",
    "security",
    "trust",
    "supply-chain"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
